{
  "schema_version": 2,
  "_comment": [
    "Templates reuse declaration fields, not instruction semantics or CPU timings. Preserve each instruction's Python base: scheduling models depend on those families.",
    "Instructions override whole template fields; lists and dictionaries are replaced, not merged. Keep existing operand placeholder names and definition order.",
    "required_features describes ISA availability, not scheduling support. Execution units, throughput and latency remain in the CPU-specific models.",
    "These notes are stripped before class and table generation. See README.instructions.md for schema rules and why some forms remain explicit or in Python."
  ],
  "templates": {
    "neon_arithmetic_binary": {
      "required_features": ["FEAT_AdvSIMD"],
      "base": "AArch64Instruction",
      "pattern": "{mnemonic} <Va>.<dt>, <Vb>.<dt>, <Vc>.<dt>",
      "inputs": ["Vb", "Vc"],
      "outputs": ["Va"]
    },
    "neon_logical_binary": {
      "required_features": ["FEAT_AdvSIMD"],
      "base": "AArch64NeonLogical",
      "pattern": "{mnemonic} <Vd>.<dt>, <Va>.<dt>, <Vb>.<dt>",
      "inputs": ["Va", "Vb"],
      "outputs": ["Vd"]
    },
    "neon_multiply_binary": {
      "required_features": ["FEAT_AdvSIMD"],
      "base": "Vmul",
      "pattern": "{mnemonic} <Vd>.<dt>, <Va>.<dt>, <Vb>.<dt>",
      "inputs": ["Va", "Vb"],
      "outputs": ["Vd"]
    },
    "neon_accumulate": {
      "_comment": "The destination is read as well as written. Using outputs instead of in_outs would lose the accumulator dependency; widening and lane accumulates follow the same rule.",
      "required_features": ["FEAT_AdvSIMD"],
      "base": "Vmla",
      "pattern": "{mnemonic} <Vd>.<dt>, <Va>.<dt>, <Vb>.<dt>",
      "inputs": ["Va", "Vb"],
      "in_outs": ["Vd"]
    },
    "neon_unary_mixed_arrangement": {
      "_comment": "MOV, XTN and UADDLP share this declaration layout, not arithmetic semantics. Separate dt0/dt1 placeholders preserve their existing parser behavior; this template does not add arrangement validation.",
      "required_features": ["FEAT_AdvSIMD"],
      "base": "AArch64Instruction",
      "pattern": "{mnemonic} <Vd>.<dt0>, <Va>.<dt1>",
      "inputs": ["Va"],
      "outputs": ["Vd"]
    },
    "neon_reverse": {
      "required_features": ["FEAT_AdvSIMD"],
      "base": "Vrev",
      "pattern": "{mnemonic} <Vd>.<dt0>, <Va>.<dt1>",
      "inputs": ["Va"],
      "outputs": ["Vd"]
    },
    "neon_zip_unzip": {
      "required_features": ["FEAT_AdvSIMD"],
      "base": "Vzip",
      "pattern": "{mnemonic} <Vd>.<dt>, <Va>.<dt>, <Vb>.<dt>",
      "inputs": ["Va", "Vb"],
      "outputs": ["Vd"]
    },
    "neon_saturating_multiply_high_lane": {
      "_comment": "The halfword lane-source encoding restricts Vb to v0-v15; the word form does not. Test the lane datatype dt1, not the destination arrangement. Lane MLA/MLS use the same condition.",
      "required_features": ["FEAT_AdvSIMD"],
      "base": "Vqdmulh",
      "pattern": "{mnemonic} <Vd>.<dt0>, <Va>.<dt0>, <Vb>.<dt1>[<index>]",
      "inputs": ["Va", "Vb"],
      "outputs": ["Vd"],
      "register_restrictions": [
        {
          "operand": "Vb",
          "when": {
            "dt1": ["h"]
          },
          "registers": {
            "prefix": "v",
            "first": 0,
            "last": 15
          }
        }
      ]
    },
    "neon_saturating_multiply_high": {
      "required_features": ["FEAT_AdvSIMD"],
      "base": "Vqdmulh",
      "pattern": "{mnemonic} <Vd>.<dt>, <Va>.<dt>, <Vb>.<dt>",
      "inputs": ["Va", "Vb"],
      "outputs": ["Vd"]
    },
    "neon_count": {
      "required_features": ["FEAT_AdvSIMD"],
      "base": "AArch64NeonCount",
      "pattern": "{mnemonic} <Vd>.<dt>, <Va>.<dt>",
      "inputs": ["Va"],
      "outputs": ["Vd"]
    },
    "neon_sha3_ternary": {
      "required_features": ["FEAT_AdvSIMD", "FEAT_SHA3"],
      "base": "SHA3Instruction",
      "pattern": "{mnemonic} <Vd>.<dt>, <Va>.<dt>, <Vb>.<dt>, <Vc>.<dt>",
      "inputs": ["Va", "Vb", "Vc"],
      "outputs": ["Vd"]
    },
    "neon_widening_multiply": {
      "required_features": ["FEAT_AdvSIMD"],
      "base": "Vmull",
      "pattern": "{mnemonic} <Vd>.<dt0>, <Va>.<dt1>, <Vb>.<dt1>",
      "inputs": ["Va", "Vb"],
      "outputs": ["Vd"]
    },
    "neon_widening_accumulate": {
      "required_features": ["FEAT_AdvSIMD"],
      "base": "Vmlal",
      "pattern": "{mnemonic} <Vd>.<dt0>, <Va>.<dt1>, <Vb>.<dt1>",
      "inputs": ["Va", "Vb"],
      "in_outs": ["Vd"]
    },
    "neon_shift_immediate": {
      "required_features": ["FEAT_AdvSIMD"],
      "base": "VShiftImmediateBasic",
      "pattern": "{mnemonic} <Vd>.<dt>, <Va>.<dt>, <imm>",
      "inputs": ["Va"],
      "outputs": ["Vd"]
    },
    "neon_rounding_shift_immediate": {
      "required_features": ["FEAT_AdvSIMD"],
      "base": "VShiftImmediateRounding",
      "pattern": "{mnemonic} <Vd>.<dt>, <Va>.<dt>, <imm>",
      "inputs": ["Va"],
      "outputs": ["Vd"]
    },
    "neon_shift_insert": {
      "required_features": ["FEAT_AdvSIMD"],
      "base": "AArch64NeonShiftInsert",
      "pattern": "{mnemonic} <Vd>.<dt>, <Va>.<dt>, <imm>",
      "inputs": ["Va"],
      "in_outs": ["Vd"]
    },
    "neon_accumulate_lane": {
      "required_features": ["FEAT_AdvSIMD"],
      "base": "Vmla",
      "pattern": "{mnemonic} <Vd>.<dt0>, <Va>.<dt0>, <Vb>.<dt1>[<index>]",
      "inputs": ["Va", "Vb"],
      "in_outs": ["Vd"],
      "register_restrictions": [
        {
          "operand": "Vb",
          "when": {
            "dt1": ["h"]
          },
          "registers": {
            "prefix": "v",
            "first": 0,
            "last": 15
          }
        }
      ]
    },
    "neon_widening_multiply_lane": {
      "_comment": "Widening forms have distinct destination, vector-source and lane-source datatypes. The halfword register restriction therefore tests dt2, not dt0/dt1; widening accumulates use the same rule.",
      "required_features": ["FEAT_AdvSIMD"],
      "base": "Vmull",
      "pattern": "{mnemonic} <Vd>.<dt0>, <Va>.<dt1>, <Vb>.<dt2>[<index>]",
      "inputs": ["Va", "Vb"],
      "outputs": ["Vd"],
      "register_restrictions": [
        {
          "operand": "Vb",
          "when": {
            "dt2": ["h"]
          },
          "registers": {
            "prefix": "v",
            "first": 0,
            "last": 15
          }
        }
      ]
    },
    "neon_widening_accumulate_lane": {
      "required_features": ["FEAT_AdvSIMD"],
      "base": "Vmlal",
      "pattern": "{mnemonic} <Vd>.<dt0>, <Va>.<dt1>, <Vb>.<dt2>[<index>]",
      "inputs": ["Va", "Vb"],
      "in_outs": ["Vd"],
      "register_restrictions": [
        {
          "operand": "Vb",
          "when": {
            "dt2": ["h"]
          },
          "registers": {
            "prefix": "v",
            "first": 0,
            "last": 15
          }
        }
      ]
    },
    "neon_vector_to_gpr_lane": {
      "base": "VecToGprMov",
      "pattern": "{mnemonic} <Xd>, <Va>.d[<index>]",
      "inputs": ["Va"],
      "outputs": ["Xd"],
      "required_features": ["FEAT_AdvSIMD"]
    },
    "neon_transpose": {
      "base": "Transpose",
      "pattern": "{mnemonic} <Vd>.<dt>, <Va>.<dt>, <Vb>.<dt>",
      "inputs": ["Va", "Vb"],
      "outputs": ["Vd"],
      "required_features": ["FEAT_AdvSIMD"]
    },
    "neon_aes_inplace": {
      "base": "AESInstruction",
      "required_features": ["FEAT_AES"],
      "pattern": "{mnemonic} <Vd>.16b, <Va>.16b",
      "inputs": ["Va"],
      "in_outs": ["Vd"]
    },
    "neon_aes_inplace_x4": {
      "base": "AArch64Instruction",
      "required_features": ["FEAT_AES"],
      "pattern": "{mnemonic} <Vd0>.16b, <Vd1>.16b, <Vd2>.16b, <Vd3>.16b, <Va>.16b",
      "inputs": ["Va"],
      "in_outs": ["Vd0", "Vd1", "Vd2", "Vd3"]
    },
    "neon_aes_transform": {
      "base": "AESInstruction",
      "required_features": ["FEAT_AES"],
      "pattern": "{mnemonic} <Vd>.16b, <Va>.16b",
      "inputs": ["Va"],
      "outputs": ["Vd"]
    },
    "neon_compare_register": {
      "base": "ASimdCompare",
      "pattern": "{mnemonic} <Vd>.<dt>, <Va>.<dt>, <Vb>.<dt>",
      "inputs": ["Va", "Vb"],
      "outputs": ["Vd"],
      "required_features": ["FEAT_AdvSIMD"]
    },
    "neon_compare_immediate": {
      "base": "ASimdCompare",
      "pattern": "{mnemonic} <Vd>.<dt>, <Va>.<dt>, <imm>",
      "inputs": ["Va"],
      "outputs": ["Vd"],
      "required_features": ["FEAT_AdvSIMD"]
    }
  },
  "instructions": [
    {
      "name": "vfcmla",
      "_comment": "Keep this form explicit: its matching arrangements, finite rotations and conditional FP16 requirement differ from the ordinary multiply-accumulate templates. Vd is an accumulator.",
      "base": "AArch64Instruction",
      "pattern": "fcmla <Vd>.<dt>, <Va>.<dt>, <Vb>.<dt>, <imm>",
      "inputs": ["Va", "Vb"],
      "in_outs": ["Vd"],
      "operand_values": {
        "dt": ["4h", "8h", "2s", "4s"],
        "imm": [0, 90, 180, 270]
      },
      "required_features": ["FEAT_FCMA"],
      "conditional_features": [
        {"when": {"dt": ["4h", "8h"]}, "requires": ["FEAT_FP16"]}
      ]
    },
    {
      "name": "fmov_w_to_s",
      "required_features": ["FEAT_FP"],
      "base": "Fmov",
      "pattern": "fmov <Sd>, <Wa>",
      "inputs": ["Wa"],
      "outputs": ["Sd"]
    },
    {
